# Local PostgreSQL
# REQUIRED: point this at the local Docker Postgres database.
DATABASE_URL=

# Better Auth
# REQUIRED: use a newly generated secret; never commit the value.
BETTER_AUTH_SECRET=
# REQUIRED: auth server URL for this environment.
BETTER_AUTH_URL=
# REQUIRED: the URL the browser uses to reach this app. Use http://localhost:3000 in local development.
NEXT_PUBLIC_APP_URL=

# OAuth providers (currently configured in Better Auth)
# REQUIRED only while the corresponding provider is enabled.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email verification via Resend
# REQUIRED for sign-up verification; use a verified sender address.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Private doctor-document storage via Cloudflare R2 (S3-compatible)
# REQUIRED before doctor document upload is used.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Bootstrap the first admin with `pnpm db:seed`.
# REQUIRED for first admin creation. Existing admin passwords are never reset by the seed.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Local, unauthenticated statement-classifier service (see ML.md).
# OPTIONAL: the app fails open if this is unset or unreachable, so intake is never blocked.
# Run it with: ml/.venv/bin/uvicorn api:app --app-dir ml --host 127.0.0.1 --port 8000
ML_SERVICE_URL=http://127.0.0.1:8000
# OPTIONAL: set to "true" to turn statement classification off entirely.
ML_CLASSIFIER_DISABLED=

# Future integrations — leave unset until their phases and vendors are selected.
# Vapi's public API key and assistant ID are required for Phase 4 voice.
# Optional server-only key for future Vapi management API calls; never expose it in browser code.
VAPI_API_KEY=
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
VAPI_ASSISTANT_ID=
# REQUIRED to receive signed Vapi server events; configure the same secret in Vapi's webhook HMAC credential.
VAPI_WEBHOOK_SECRET=
# Vapi's cloud must reach this app over public HTTPS (use a local tunnel in development).
# OPTIONAL in development: falls back to NEXT_PUBLIC_APP_URL when unset. A quick tunnel
# issues a new hostname each restart, so re-copy this whenever you restart the tunnel.
VAPI_CALLBACK_BASE_URL=
# REQUIRED for Phase 4 AI features, after the provider is selected.
LLM_API_KEY=
# Optional model override. Defaults to the lower-cost gpt-4o-mini model.
OPENAI_MODEL=gpt-4o-mini

## From here these keys are not available yet ##
# REQUIRED for Phase 8 background jobs, after Trigger.dev project setup.
TRIGGER_PROJECT_REF=
TRIGGER_SECRET_KEY=
# REQUIRED for Phase 6 OCR, after the provider is selected.
OCR_API_KEY=
# REQUIRED for Phase 8 messaging, after the provider is selected.
MESSAGING_API_KEY=
MESSAGING_WEBHOOK_SECRET=
