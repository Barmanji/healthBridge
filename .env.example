# Local PostgreSQL
# REQUIRED: point this at the local Docker Postgres database.
DATABASE_URL=

# Better Auth
# REQUIRED: use a newly generated secret; never commit the value.
BETTER_AUTH_SECRET=
# REQUIRED: auth server URL for this environment.
BETTER_AUTH_URL=
NEXT_PUBLIC_APP_URL=

# OAuth providers (currently configured in Better Auth)
# REQUIRED only while the corresponding provider is enabled.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email verification via Resend
# REQUIRED for sign-up verification; use a verified sender address.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Private doctor-document storage via Cloudflare R2 (S3-compatible)
# REQUIRED before doctor document upload is used.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Bootstrap the first admin with `pnpm db:seed`.
# REQUIRED for first admin creation. Existing admin passwords are never reset by the seed.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Future integrations — leave unset until their phases and vendors are selected.
# REQUIRED for Phase 4 voice, only after Vapi configuration is approved.
VAPI_API_KEY=
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
VAPI_ASSISTANT_ID=
VAPI_WEBHOOK_SECRET=
# REQUIRED for Phase 4 AI features, after the provider is selected.
LLM_API_KEY=
# REQUIRED for Phase 8 background jobs, after Trigger.dev project setup.
TRIGGER_PROJECT_REF=
TRIGGER_SECRET_KEY=
# REQUIRED for Phase 6 OCR, after the provider is selected.
OCR_API_KEY=
# REQUIRED for Phase 8 messaging, after the provider is selected.
MESSAGING_API_KEY=
MESSAGING_WEBHOOK_SECRET=
